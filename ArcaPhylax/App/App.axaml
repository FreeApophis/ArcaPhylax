<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ArcaPhylax.App.App">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://ArcaPhylax/Themes/ThemeBrushes.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
    <StyleInclude Source="avares://ArcaPhylax/Styles/CardStyles.axaml"/>
    <StyleInclude Source="avares://ArcaPhylax/Styles/TextStyles.axaml"/>
    <StyleInclude Source="avares://ArcaPhylax/Styles/ButtonStyles.axaml"/>
    <StyleInclude Source="avares://ArcaPhylax/Styles/NavigationStyles.axaml"/>
  </Application.Styles>

</Application>

<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Nocturne applied to the built-in controls: the surface-filled input,
         the 8px radius, the compact 0.7× padding, and the 2px accent focus
         ring in place of the platform default. Colour comes from the System*
         palette in ThemeBrushes.axaml; this file carries shape and rhythm. -->

    <!-- The window sets the body font once; everything inherits it. -->
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="{DynamicResource FontBody}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
    </Style>
    <Style Selector="UserControl">
        <Setter Property="FontFamily" Value="{DynamicResource FontBody}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
    </Style>

    <!-- ── Focus ────────────────────────────────────────────────────────
         Keyboard focus is always the accent ring, offset from the control —
         never a browser/platform default. -->
    <Style Selector="Button, ToggleButton, RepeatButton, TextBox, ComboBox, CheckBox,
                     RadioButton, ListBoxItem, TabItem, Slider, NumericUpDown,
                     ToggleSwitch, CalendarDatePicker, AutoCompleteBox">
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="2"
                        CornerRadius="{DynamicResource RadiusMd}"
                        Margin="-3"/>
            </FocusAdornerTemplate>
        </Setter>
    </Style>

    <!-- ── Text inputs ──────────────────────────────────────────────────
         A surface fill inside a hairline border; the caret takes the accent. -->
    <Style Selector="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource FontBody}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeControl}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}"/>
        <Setter Property="Padding" Value="{DynamicResource PadControl}"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentTintStrongBrush}"/>
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource PrimaryTextBrush}"/>
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource Neutral600}"/>
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="TextBox /template/ TextBlock#PART_Placeholder,
                     TextBox /template/ TextBlock#PART_FloatingPlaceholder">
        <Setter Property="Foreground" Value="{DynamicResource FaintTextBrush}"/>
    </Style>
    <!-- Multi-line notes fields. -->
    <Style Selector="TextBox[AcceptsReturn=True]">
        <Setter Property="MinHeight" Value="88"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
    </Style>
    <!-- The search field reads as one long, quiet input. -->
    <Style Selector="TextBox.SearchBox, TextBox.searchBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="12,7"/>
    </Style>

    <!-- Form labels are quiet and small — the field itself carries the weight. -->
    <Style Selector="TextBlock.fieldLabel">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}"/>
    </Style>

    <Style Selector="AutoCompleteBox, NumericUpDown">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeControl}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}"/>
        <Setter Property="MinHeight" Value="34"/>
    </Style>

    <!-- ── ComboBox ─────────────────────────────────────────────────────── -->
    <Style Selector="ComboBox">
        <Setter Property="FontFamily" Value="{DynamicResource FontBody}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeControl}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}"/>
        <Setter Property="Padding" Value="{DynamicResource PadControl}"/>
        <Setter Property="MinHeight" Value="34"/>
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeControl}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="MinHeight" Value="0"/>
    </Style>

    <!-- ── Lists ───────────────────────────────────────────────────────── -->
    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}"/>
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeControl}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentTintBrush}"/>
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentTintStrongBrush}"/>
    </Style>

    <!-- ── Choices ─────────────────────────────────────────────────────── -->
    <Style Selector="CheckBox, RadioButton">
        <Setter Property="FontFamily" Value="{DynamicResource FontBody}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeControl}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="MinHeight" Value="0"/>
    </Style>

    <!-- ── Tabs ────────────────────────────────────────────────────────── -->
    <Style Selector="TabItem">
        <Setter Property="FontFamily" Value="{DynamicResource FontHeading}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeControl}"/>
        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="TabItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <!-- The selected-tab marker is a short accent line: solid, not faded. -->
    <Style Selector="TabItem /template/ Border#PART_SelectedPipe">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <!-- ── Data grid ───────────────────────────────────────────────────── -->
    <Style Selector="DataGrid">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeControl}"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource CardBorderBrush}"/>
        <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
        <Setter Property="RowBackground" Value="Transparent"/>
    </Style>
    <Style Selector="DataGridColumnHeader">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontHeading}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeMicro}"/>
        <Setter Property="LetterSpacing" Value="1"/>
        <Setter Property="SeparatorBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="8,6"/>
    </Style>
    <Style Selector="DataGridCell">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>
    <Style Selector="DataGridRow:selected">
        <Setter Property="Background" Value="{DynamicResource AccentTintBrush}"/>
    </Style>

    <!-- ── Chrome ──────────────────────────────────────────────────────── -->
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="Padding" Value="10,6"/>
    </Style>
    <Style Selector="Separator">
        <Setter Property="Background" Value="{DynamicResource DividerBrush}"/>
        <Setter Property="Height" Value="1"/>
    </Style>
    <Style Selector="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}"/>
    </Style>
    <Style Selector="Expander">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}"/>
    </Style>
    <Style Selector="ScrollViewer">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Border.card ScrollViewer, Border.Card ScrollViewer">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
</Styles>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ArcaPhylax.ViewModels"
        xmlns:ir="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.ItemsRepeater"
        xmlns:irl="clr-namespace:Avalonia.Layout;assembly=Avalonia.Controls.ItemsRepeater"
        x:Class="ArcaPhylax.Views.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainWindowViewModel"
        Width="1280" Height="820"
        Background="{DynamicResource AppBackgroundBrush}"
        Title=""
        ExtendClientAreaToDecorationsHint="True">


  <SplitView IsPaneOpen="{Binding IsPaneOpen}"
              DisplayMode="CompactInline"
              CompactPaneLength="64"
              OpenPaneLength="232"
              PaneBackground="{DynamicResource SidebarBrush}">

    <SplitView.Pane>
      <Grid RowDefinitions="Auto,*">
        <!-- Header: kebab toggle + brand (brand hides when collapsed). -->
        <Grid Grid.Row="0" Margin="9,14,8,6" ColumnDefinitions="Auto,*">
          <Button Grid.Column="0" Classes="kebab"
                  Command="{Binding TogglePaneCommand}"
                  ToolTip.Tip="Toggle menu">
            <PathIcon Data="{Binding MenuIcon}"/>
          </Button>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                      VerticalAlignment="Center" Margin="6,0,0,0"
                      IsVisible="{Binding IsPaneOpen}">
            <Border Width="14" Height="14" CornerRadius="4"
                    Background="{DynamicResource AccentBrush}"/>
            <TextBlock Text="ArcaPhylax" FontSize="17" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>

        <!-- Navigation items, with a single accent pill that slides to the selected item. -->
        <Grid Grid.Row="1" x:Name="NavArea">
          <Border x:Name="NavHighlight"
                  Background="{DynamicResource AccentBrush}"
                  CornerRadius="10" Margin="8,0"
                  HorizontalAlignment="Stretch" VerticalAlignment="Top"
                  IsVisible="False" IsHitTestVisible="False">
            <Border.RenderTransform>
              <TranslateTransform>
                <TranslateTransform.Transitions>
                  <Transitions>
                    <DoubleTransition Property="Y" Duration="0:0:0.24" Easing="CubicEaseOut"/>
                  </Transitions>
                </TranslateTransform.Transitions>
              </TranslateTransform>
            </Border.RenderTransform>
          </Border>

          <ListBox x:Name="NavList" Classes="nav"
                   ItemsSource="{Binding Tabs}"
                   SelectedItem="{Binding SelectedTab}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:TabButtonViewModel">
                <StackPanel Orientation="Horizontal" Spacing="16">
                  <PathIcon Data="{Binding Icon}" Width="20" Height="20"/>
                  <TextBlock Text="{Binding Title}" FontSize="14"
                             VerticalAlignment="Center"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Grid>
    </SplitView.Pane>

    <!-- Page host. -->
    <Border Padding="28" Background="Transparent">
      <ContentControl Content="{Binding CurrentContent}"/>
    </Border>
  </SplitView>
 </Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ArcaPhylax.ViewModels"
        xmlns:ir="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.ItemsRepeater"
        xmlns:irl="clr-namespace:Avalonia.Layout;assembly=Avalonia.Controls.ItemsRepeater"
        x:Class="ArcaPhylax.Views.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainWindowViewModel"
        Width="1280" Height="820"
        Background="{DynamicResource AppBackgroundBrush}"
        Title=""
        ExtendClientAreaToDecorationsHint="True">


  <SplitView IsPaneOpen="{Binding IsPaneOpen}"
              DisplayMode="CompactInline"
              CompactPaneLength="64"
              OpenPaneLength="232"
              PaneBackground="{DynamicResource SidebarBrush}">

    <SplitView.Pane>
      <Grid RowDefinitions="Auto,*">
        <!-- Header: kebab toggle + brand (brand hides when collapsed).
             Doubles as window chrome: dragging it moves the window. The kebab Button marks
             PointerPressed as handled, so it still toggles instead of starting a drag. -->
        <Grid Grid.Row="0" Margin="9,14,8,6" ColumnDefinitions="Auto,*"
              Background="Transparent"
              PointerPressed="OnChromePointerPressed">
          <Button Grid.Column="0" Classes="kebab"
                  Command="{Binding TogglePaneCommand}"
                  ToolTip.Tip="Toggle menu">
            <Image Width="32" Height="32" Source="avares://ArcaPhylax/Resources/arca-phylax-icon.png"/>
          </Button>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                      VerticalAlignment="Center" Margin="6,0,0,0"
                      IsVisible="{Binding IsPaneOpen}">
            <TextBlock Text="ArcaPhylax" Classes="navBrand"
                       VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>

        <!-- Navigation: weighted tabs fill the top, Configure/About are pinned to the bottom.
             A single accent pill slides to the selected item across both lists. -->
        <Grid Grid.Row="1" x:Name="NavArea" RowDefinitions="*,Auto">
          <Grid.Resources>
            <DataTemplate x:Key="NavItemTemplate" x:DataType="vm:TabButtonViewModel">
              <StackPanel Orientation="Horizontal" Spacing="16">
                <PathIcon Data="{Binding Icon}" Width="20" Height="20"/>
                <TextBlock Text="{Binding Title}" FontSize="14"
                           VerticalAlignment="Center"/>
              </StackPanel>
            </DataTemplate>
          </Grid.Resources>

          <Border x:Name="NavHighlight" Grid.RowSpan="2" Classes="navPill"
                  Margin="8,0"
                  HorizontalAlignment="Stretch" VerticalAlignment="Top"
                  IsVisible="False" IsHitTestVisible="False">
            <Border.RenderTransform>
              <TranslateTransform>
                <TranslateTransform.Transitions>
                  <Transitions>
                    <DoubleTransition Property="Y" Duration="0:0:0.24" Easing="CubicEaseOut"/>
                  </Transitions>
                </TranslateTransform.Transitions>
              </TranslateTransform>
            </Border.RenderTransform>
          </Border>

          <ListBox x:Name="NavList" Grid.Row="0" Classes="nav"
                   ItemsSource="{Binding Tabs}"
                   SelectedItem="{Binding SelectedMainTab}"
                   ItemTemplate="{StaticResource NavItemTemplate}"/>

          <ListBox x:Name="NavListBottom" Grid.Row="1" Classes="nav"
                   VerticalAlignment="Bottom"
                   ItemsSource="{Binding BottomTabs}"
                   SelectedItem="{Binding SelectedBottomTab}"
                   ItemTemplate="{StaticResource NavItemTemplate}"/>
        </Grid>
      </Grid>
    </SplitView.Pane>

    <!-- Page host, below a drag strip that stands in for the missing title bar and keeps
         page content clear of the system caption buttons. The strip stops short of those
         buttons so close/minimise/maximise stay clickable rather than starting a drag. -->
    <Grid RowDefinitions="Auto,*">
      <Border Grid.Row="0" Height="{DynamicResource TitleBarHeight}"
              Margin="{DynamicResource CaptionButtonsReserve}"
              Background="Transparent"
              PointerPressed="OnChromePointerPressed"/>

      <Border Grid.Row="1" Padding="{DynamicResource PadPageBelowChrome}" Background="Transparent">
        <ContentControl Content="{Binding CurrentContent}"/>
      </Border>
    </Grid>
  </SplitView>
 </Window>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ArcaPhylax.Views.ImagesView">
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
    <TextBlock Classes="pageTitle" Text="Images"/>
    <TextBlock Grid.Row="1" Classes="pageSubtitle"
               Text="Browse and filter image assets. Hook thumbnail loading + cache here."/>
    <Border Grid.Row="2" Classes="well" Margin="0,11,0,0">
      <TextBlock Classes="subtle" TextWrapping="Wrap"
                 Text="This area is resolved via Autofac (ViewFactory) and can host complex views, editors, media players, chat UI, etc."/>
    </Border>
  </Grid>
</UserControl>

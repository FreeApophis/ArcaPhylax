<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ArcaPhylax.Views.ChatView">
  <Grid RowDefinitions="Auto,Auto,*" Margin="6">
    <TextBlock Text="💬 Chat" FontSize="22" />
    <TextBlock Grid.Row="1" Text="Chat or assistant panel. Dock tools, history, prompts, etc." Margin="0,8,0,0" />
    <Border Grid.Row="2" Margin="0,14,0,0" CornerRadius="12" BorderThickness="1" Padding="14">
      <TextBlock Text="This area is resolved via Autofac (ViewFactory) and can host complex views, editors, media players, chat UI, etc."
                  TextWrapping="Wrap"/>
    </Border>
  </Grid>
</UserControl>

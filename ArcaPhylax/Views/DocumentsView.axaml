<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ArcaPhylax.ViewModels"
             x:Class="ArcaPhylax.Views.DocumentsView"
             x:DataType="vm:DocumentsViewModel">

  <Grid RowDefinitions="Auto,Auto,*" Margin="6">
    <TextBlock Text="📄 Documents" FontSize="22"/>

    <TextBlock Grid.Row="1" Text="{Binding Status}" Margin="0,8,0,0" />

    <Grid Grid.Row="2" Margin="0,14,0,0" RowDefinitions="*,10,420">
      <Border Grid.Row="0" BorderBrush="#2A2F35" BorderThickness="1" CornerRadius="12" Padding="12">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Text="Recent drops" FontSize="14"/>
          <DataGrid Grid.Row="1"
                    ItemsSource="{Binding Recent}"
                    IsReadOnly="True"
                    HeadersVisibility="Column"
                    GridLinesVisibility="None"
                    Background="Transparent"
                    BorderThickness="0"
                    RowHeight="30"
                    Margin="0,10,0,0">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="80"/>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="Path" Binding="{Binding OriginalPath}" Width="220"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <Border Grid.Row="2" x:Name="DropZone" BorderBrush="#2A2F35" BorderThickness="2" CornerRadius="12" Padding="20">

        <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="Dateien oder Ordner hier hineinziehen" FontSize="16" HorizontalAlignment="Center"/>
          <TextBlock Text="Pfade werden gespeichert (wenn verfügbar), sonst importiert." FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>

    </Grid> 
  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ArcaPhylax.ViewModels"
             x:Class="ArcaPhylax.Views.DocumentsView"
             x:DataType="vm:DocumentsViewModel">

  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
    <TextBlock Classes="pageTitle" Text="Documents"/>

    <TextBlock Grid.Row="1" Classes="pageSubtitle" Text="{Binding Status}"/>

    <Grid Grid.Row="2" Margin="0,11,0,0" RowDefinitions="*,11,420">
      <Border Grid.Row="0" Classes="card">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Classes="sectionTitle" Text="Recent drops"/>
          <DataGrid Grid.Row="1"
                    ItemsSource="{Binding Recent}"
                    IsReadOnly="True"
                    HeadersVisibility="Column"
                    RowHeight="30"
                    Margin="0,8,0,0">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="80"/>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="Path" Binding="{Binding OriginalPath}" Width="220"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <!-- The drop target is a sunken well with a dashed accent-capable edge. -->
      <Border Grid.Row="2" x:Name="DropZone" Classes="well" Padding="22">
        <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Classes="h5" Text="Dateien oder Ordner hier hineinziehen"
                     HorizontalAlignment="Center"/>
          <TextBlock Classes="subtle small" HorizontalAlignment="Center" TextWrapping="Wrap"
                     Text="Pfade werden gespeichert (wenn verfügbar), sonst importiert."/>
        </StackPanel>
      </Border>

    </Grid>
  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ArcaPhylax.Controls"
             x:Class="ArcaPhylax.Views.SettingsView">
  <Grid RowDefinitions="Auto,Auto,*" Margin="6">
    <TextBlock Text="⚙ Settings" FontSize="22" Foreground="#D9DEE5"/>
    <TextBlock Grid.Row="1" Text="App settings. Themes, storage paths, indexing, etc." Margin="0,8,0,0" Foreground="#8C98A6"/>
    <Border Grid.Row="2" Margin="0,14,0,0" CornerRadius="12" Background="#121416" BorderBrush="#2A2F35" BorderThickness="1" Padding="14">
      <TextBlock Text="This area is resolved via Autofac (ViewFactory) and can host complex views, editors, media players, chat UI, etc."
                 Foreground="#B7C0CB" TextWrapping="Wrap"/>

    </Border>
  </Grid>
</UserControl>

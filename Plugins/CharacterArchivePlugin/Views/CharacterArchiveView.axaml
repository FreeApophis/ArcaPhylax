<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CharacterArchivePlugin.ViewModels"
             xmlns:data="clr-namespace:CharacterArchivePlugin.Data"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:sys="using:System"
             x:Class="CharacterArchivePlugin.Views.CharacterArchiveView"
             x:DataType="vm:CharacterArchiveViewModel">

  <UserControl.Styles>
    <!-- Diagonal corner banner over a card image; the parent Border clips it into a ribbon. -->
    <Style Selector="Border.ribbon">
      <Setter Property="Width" Value="150"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="Margin" Value="0,24,-44,0"/>
      <Setter Property="RenderTransform" Value="rotate(45deg)"/>
      <Setter Property="BoxShadow" Value="0 1 4 0 #66000000"/>
    </Style>
    <Style Selector="Border.ribbon > TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <!-- Header text on each collapsible detail section (Description, Personality, …). -->
    <Style Selector="Expander.section > /template/ ToggleButton TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Opacity" Value="0.8"/>
    </Style>
    <Style Selector="Expander.section">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <!-- Small pill beside the character name showing the author's character_version. -->
    <Style Selector="Border.version-tag">
      <Setter Property="Background" Value="#E0E0E0"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="6,1"/>
      <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>
    <Style Selector="Border.version-tag > TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#404040"/>
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="*,8,560" Margin="12">

    <!-- Left: search + tag filter + result grid -->
    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" RowSpacing="10">
      <StackPanel Grid.Row="0" Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox Width="360" PlaceholderText="Search characters…" Text="{Binding SearchText}">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}"/>
            </TextBox.KeyBindings>
          </TextBox>
          <Button Content="Search" Classes="accent" Command="{Binding SearchCommand}"/>
        </StackPanel>
        <TextBlock Text="{Binding Status}" Opacity="0.7" FontSize="12"/>
      </StackPanel>

      <!-- Tag filter: active tags (AND) + a picker of popular/matching tags -->
      <Border Grid.Row="1" Classes="card" Padding="8">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Width="220" PlaceholderText="Filter tags…" FontSize="12" Text="{Binding TagFilter}"/>
            <Button Content="Clear tags" Command="{Binding ClearTagsCommand}"/>
          </StackPanel>

          <ItemsControl ItemsSource="{Binding SelectedTags}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="sys:String">
                <Button Margin="0,0,6,6" Padding="8,3" Classes="accent"
                        Command="{Binding $parent[UserControl].((vm:CharacterArchiveViewModel)DataContext).RemoveTagCommand}"
                        CommandParameter="{Binding}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding}" FontSize="11"/>
                    <TextBlock Text="✕" FontSize="11" Opacity="0.8"/>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding AvailableTags}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="data:TagOption">
                  <Button Margin="0,0,6,6" Padding="8,3"
                          Command="{Binding $parent[UserControl].((vm:CharacterArchiveViewModel)DataContext).AddTagCommand}"
                          CommandParameter="{Binding Tag}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding Tag}" FontSize="11"/>
                      <TextBlock Text="{Binding CountLabel}" FontSize="11" Opacity="0.55"/>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>

      <Border Grid.Row="2" Classes="card" Padding="6">
        <ListBox ItemsSource="{Binding Results}"
                 SelectedItem="{Binding SelectedTile}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:CharacterTileVm">
              <StackPanel Width="170" Margin="4" Spacing="6">
                <Panel Height="200">
                  <!-- Offset "cards behind" so a stack reads as more than one; only for stacks. -->
                  <Border Height="200" CornerRadius="6" IsVisible="{Binding IsStack}"
                          Background="{DynamicResource ThumbBackgroundBrush}"
                          BorderBrush="#40000000" BorderThickness="1"
                          RenderTransform="translate(6px, 6px)"/>
                  <Border Height="200" CornerRadius="6" IsVisible="{Binding IsStack}"
                          Background="{DynamicResource ThumbBackgroundBrush}"
                          BorderBrush="#40000000" BorderThickness="1"
                          RenderTransform="translate(3px, 3px)"/>
                  <Border Height="200" CornerRadius="6" ClipToBounds="True"
                          Background="{DynamicResource ThumbBackgroundBrush}">
                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                  </Border>
                  <!-- Variant count badge. -->
                  <Border IsVisible="{Binding IsStack}"
                          HorizontalAlignment="Right" VerticalAlignment="Top"
                          Margin="0,6,6,0" Padding="7,2" CornerRadius="10" Background="#CC000000">
                    <TextBlock Text="{Binding CountLabel}" Foreground="White"
                               FontSize="12" FontWeight="Bold"/>
                  </Border>
                </Panel>
                <!-- NoWrap (not Wrap) on purpose: Avalonia's text wrapper throws
                     "Cannot split: requested length N consumes entire run" on some card names
                     (emoji / unbreakable trailing clusters). The upstream fix (PR #21370 / issue
                     #21252) is unmerged and not in 12.1.0, so we avoid the wrapping path here —
                     ellipsis trimming uses the collapsing path, which sidesteps the bug. -->
                <TextBlock Text="{Binding Name}" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"
                           MaxWidth="162"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </Grid>

    <!-- Right: detail pane -->
    <Border Grid.Column="2" Classes="card" Padding="14">
      <Panel>
        <TextBlock Text="Select a character to see its details."
                   IsVisible="{Binding !HasSelection}"
                   Opacity="0.6" TextWrapping="Wrap"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <Grid IsVisible="{Binding HasSelection}" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="8">
          <Border Grid.Row="0" Height="280" CornerRadius="8" ClipToBounds="True"
                  Background="{DynamicResource ThumbBackgroundBrush}">
            <Panel>
              <Image Source="{Binding SelectedImage}" Stretch="Uniform"/>

              <!-- Card spec ribbon: amber V1, green V2. -->
              <Border Classes="ribbon" Background="#D17B00" IsVisible="{Binding IsSelectedV1}">
                <TextBlock Text="V1"/>
              </Border>
              <Border Classes="ribbon" Background="#2E7D32" IsVisible="{Binding IsSelectedV2}">
                <TextBlock Text="V2"/>
              </Border>
            </Panel>
          </Border>

          <!-- Variant switcher: the characters sharing this image. Only shown for stacks. -->
          <StackPanel Grid.Row="1" Spacing="4" IsVisible="{Binding HasVariants}">
            <TextBlock Text="Variants sharing this image" Opacity="0.6" FontSize="12"/>
            <ListBox ItemsSource="{Binding Variants}" SelectedItem="{Binding SelectedVariant}"
                     Background="Transparent" BorderThickness="0" MaxHeight="96"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="data:CharacterTile">
                  <StackPanel Orientation="Horizontal" Spacing="6" Margin="2">
                    <TextBlock Text="{Binding Name}" FontSize="11"/>
                    <TextBlock Text="{Binding Source}" FontSize="11" Opacity="0.55"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>

          <DockPanel Grid.Row="2">
            <Button DockPanel.Dock="Right" Content="Download" Classes="accent"
                    VerticalAlignment="Top" Margin="8,0,0,0"
                    Command="{Binding DownloadCommand}"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding SelectedDetail.Name}"
                         FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <Border Classes="version-tag"
                      RenderTransform="translate(0px, -16px)"
                      IsVisible="{Binding SelectedCharacterVersion, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding SelectedCharacterVersion}"/>
              </Border>
            </StackPanel>
          </DockPanel>

          <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{Binding SelectedDetail.Source}" Opacity="0.6" FontSize="12"/>
            <TextBlock Text="·" Opacity="0.6" FontSize="12"
                       IsVisible="{Binding SelectedDetail.Author, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Text="{Binding SelectedDetail.Author}" Opacity="0.6" FontSize="12"/>
          </StackPanel>

          <ItemsControl Grid.Row="4" ItemsSource="{Binding SelectedDetail.Tags}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="sys:String">
                <Button Margin="0,0,6,6" Padding="8,3"
                        ToolTip.Tip="Add as tag filter"
                        Command="{Binding $parent[UserControl].((vm:CharacterArchiveViewModel)DataContext).AddTagCommand}"
                        CommandParameter="{Binding}">
                  <TextBlock Text="{Binding}" FontSize="11"/>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ScrollViewer Grid.Row="5" Margin="0,4,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
              <TextBlock Text="{Binding SelectedDetail.Summary}"
                         FontStyle="Italic" Opacity="0.85" TextWrapping="Wrap"
                         IsVisible="{Binding SelectedDetail.Summary, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>

              <Expander Classes="section" Header="Description" IsExpanded="True"
                        IsVisible="{Binding SelectedDetail.Description, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding SelectedDetail.Description}" TextWrapping="Wrap"/>
              </Expander>

              <Expander Classes="section" Header="Personality"
                        IsVisible="{Binding SelectedPersonality, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding SelectedPersonality}" TextWrapping="Wrap"/>
              </Expander>

              <Expander Classes="section" Header="Scenario"
                        IsVisible="{Binding SelectedScenario, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding SelectedScenario}" TextWrapping="Wrap"/>
              </Expander>

              <Expander Classes="section" Header="Greeting"
                        IsVisible="{Binding SelectedGreeting, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding SelectedGreeting}" TextWrapping="Wrap"/>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Panel>
    </Border>

  </Grid>
</UserControl>

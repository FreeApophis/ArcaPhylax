<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CharacterArchivePlugin.ViewModels"
             x:Class="CharacterArchivePlugin.Views.CharacterArchiveConfigurationView"
             x:DataType="vm:CharacterArchiveConfigurationViewModel">

  <StackPanel Spacing="10">

    <StackPanel Spacing="6">
      <TextBlock Text="PostgreSQL host" FontWeight="SemiBold"/>
      <TextBox Text="{Binding Settings.DatabaseHost}" PlaceholderText="localhost"/>
    </StackPanel>

    <StackPanel Spacing="6">
      <TextBlock Text="PostgreSQL port" FontWeight="SemiBold"/>
      <TextBox Text="{Binding Settings.DatabasePort}"               PlaceholderText="5432"/>
    </StackPanel>

    <StackPanel Spacing="6">
      <TextBlock Text="PostgreSQL database name" FontWeight="SemiBold"/>
      <TextBox Text="{Binding Settings.DatabaseName}" PlaceholderText="char_archive"/>
    </StackPanel>

    <StackPanel Spacing="6">
      <TextBlock Text="PostgreSQL username" FontWeight="SemiBold"/>
      <TextBox Text="{Binding Settings.DatabaseUsername}" PlaceholderText="username"/>
    </StackPanel>

    <StackPanel Spacing="6">
      <TextBlock Text="PostgreSQL password" FontWeight="SemiBold"/>
      <TextBox Text="{Binding Settings.DatabasePassword}" PlaceholderText="password"/>
    </StackPanel>

    <StackPanel Spacing="6">
      <TextBlock Text="Image root (hashed-data)" FontWeight="SemiBold"/>
      <TextBox Text="{Binding Settings.ImageRoot}"/>
    </StackPanel>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Test connection" Classes="accent" Command="{Binding TestConnectionCommand}"/>
      <Button Content="Save" Command="{Binding SaveCommand}"/>
      <Button Content="Rebuild search index" Command="{Binding RebuildSearchIndexCommand}"/>
    </StackPanel>

    <TextBlock Text="Rebuild the search index after the archive changes (creates it if missing)."
               Opacity="0.6" FontSize="11" TextWrapping="Wrap"/>

    <TextBlock Text="{Binding Status}" Opacity="0.7" FontSize="12"/>
  </StackPanel>
</UserControl>

<Project Sdk="Microsoft.NET.Sdk">

	<!-- Plugin package metadata (plugin.json / catalog). -->
	<PropertyGroup>
		<PluginId>ArcaPhylax.Scanner</PluginId>
		<Title>Scanner</Title>
		<Description>Scan documents from TWAIN/WIA/ESCL scanners and save them as PDF or images.</Description>
		<Version>1.0.0</Version>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" />
		<PackageReference Include="Avalonia.Desktop" />
		<PackageReference Include="Avalonia.Themes.Fluent" />
		<PackageReference Include="Avalonia.Controls.ItemsRepeater" />
		<PackageReference Include="Avalonia.Controls.DataGrid" />
		<PackageReference Include="Autofac" />
		<PackageReference Include="CommunityToolkit.Mvvm" />
		<PackageReference Include="Dapper" />
		<PackageReference Include="Funcky" />
		<PackageReference Include="Microsoft.Data.Sqlite" />
		<PackageReference Include="NAPS2.Sdk" />
		<!-- Skia image backend; replaces NAPS2.Images.ImageSharp (SixLabors license gate).
		     Requires SkiaSharp 4.x, pinned centrally to match the host. -->
		<PackageReference Include="NAPS2.Images.Skia" />

		<!-- Optional, aber für TWAIN unter Windows oft nötig -->
		<PackageReference Include="NAPS2.Sdk.Worker.Win32" Condition="'$(OS)' == 'Windows_NT'" />
	</ItemGroup>


	<ItemGroup>
		<ProjectReference Include="..\..\ArcaPhylax.Plugin.Sdk\ArcaPhylax.Plugin.Sdk.csproj" />
	</ItemGroup>

</Project>

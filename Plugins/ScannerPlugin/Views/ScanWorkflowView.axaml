<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ArcaPhylax.ViewModels"
             x:Class="ArcaPhylax.Views.ScanWorkflowView"
             x:DataType="vm:ScanWorkflowViewModel">

  <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="2*,3*"
        Margin="12">

    <!-- Top: Scanner Auswahl + Scan -->
    <Border Grid.Row="0" Grid.ColumnSpan="2" Padding="10" CornerRadius="10">
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Scanner aktualisieren"
                  Command="{Binding RefreshDevicesCommand}" />
          <ComboBox Width="360"
                    ItemsSource="{Binding Devices}"
                    SelectedItem="{Binding SelectedDevice}"
                    DisplayMemberBinding="{Binding Name}" />
          <Button Content="Scannen"
                  Command="{Binding ScanCommand}"
                  IsEnabled="{Binding CanScan}" />
          <Button Content="Scan abbrechen"
                  Command="{Binding CancelScanCommand}"
                  IsEnabled="{Binding IsScanning}" />
        </StackPanel>

        <TextBlock Text="{Binding Status}" Opacity="0.85"/>
      </StackPanel>
    </Border>

    <!-- Left: Seitenliste -->
    <Border Grid.Row="2" Grid.Column="0" Padding="10" CornerRadius="10">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Alle auswählen" Command="{Binding SelectAllCommand}" />
            <Button Content="Auswahl aufheben" Command="{Binding SelectNoneCommand}" />
            <Button Content="Ausgewählte löschen" Command="{Binding DeleteSelectedPagesCommand}"
                    IsEnabled="{Binding HasAnySelected}" />
          </StackPanel>
        </StackPanel>

        <ListBox ItemsSource="{Binding Pages}"
                 SelectedItem="{Binding ActivePage}"
                 Margin="0,10,0,0">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Padding="6" CornerRadius="8">
                <Grid ColumnDefinitions="Auto,Auto,*">
                  <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>
                  <Image Width="64" Height="64" Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Info}" Opacity="0.75" FontSize="12"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Right: Preview + Export -->
    <Border Grid.Row="2" Grid.Column="1" Padding="10" CornerRadius="10">
      <Grid RowDefinitions="Auto,*,Auto">

        <StackPanel Grid.Row="0" Spacing="6">
          <TextBlock Text="Dokumentdaten" FontWeight="SemiBold"/>
          <TextBox PlaceholderText="Name (PDF Titel)"
                   Text="{Binding DocumentName}" />
          <TextBox PlaceholderText="Tags (Komma-separiert)"
                   Text="{Binding TagsText}" />
        </StackPanel>

        <Border Grid.Row="1" Padding="8" CornerRadius="10">
          <ScrollViewer>
            <Image Source="{Binding ActivePagePreview}" Stretch="Uniform"/>
          </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="PDF exportieren"
                  Command="{Binding ExportPdfCommand}"
                  IsEnabled="{Binding CanExport}" />
        </StackPanel>

      </Grid>
    </Border>

  </Grid>
</UserControl>

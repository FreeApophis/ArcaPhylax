<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ArcaPhylax.ViewModels"
             x:Class="ArcaPhylax.Views.ScanWorkflowView"
             x:DataType="vm:ScanWorkflowViewModel">

  <Grid RowDefinitions="Auto,*,Auto" Margin="12" RowSpacing="12">

    <!-- Top: profile selection + scan -->
    <Border Grid.Row="0" Classes="card" Padding="14">
      <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="Profile" VerticalAlignment="Center"/>
          <ComboBox Width="240"
                    ItemsSource="{Binding Settings.Profiles}"
                    SelectedItem="{Binding Settings.SelectedProfile}"
                    DisplayMemberBinding="{Binding Name}"
                    PlaceholderText="No profile selected"/>
          <Button Content="Scan" Classes="accent" Command="{Binding ScanCommand}"/>
          <Button Content="Cancel" Command="{Binding CancelScanCommand}"/>
        </StackPanel>

        <TextBlock Text="{Binding DeviceDisplay, StringFormat='Scanner: {0}'}"
                   Classes="subtle" FontSize="12"/>
        <TextBlock Text="{Binding Status}" Opacity="0.8" FontSize="12"/>
      </StackPanel>
    </Border>

    <!-- Middle: scanned pages -->
    <Border Grid.Row="1" Classes="card" Padding="6">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Pages}" Margin="6">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ScanPageViewModel">
              <Border Width="190" Margin="6" Padding="8" CornerRadius="10"
                      BorderThickness="1"
                      BorderBrush="{DynamicResource CardBorderBrush}">
                <StackPanel Spacing="6">
                  <Border Height="220" CornerRadius="6" ClipToBounds="True"
                          Background="{DynamicResource ThumbBackgroundBrush}">
                    <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                  </Border>
                  <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding DisplayName}"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- Bottom: naming + saving -->
    <Border Grid.Row="2" Classes="card" Padding="14">
      <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Select all" Command="{Binding SelectAllCommand}"/>
          <Button Content="Select none" Command="{Binding SelectNoneCommand}"/>
          <Button Content="Delete selected" Command="{Binding DeleteSelectedCommand}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="File name" VerticalAlignment="Center"/>
          <TextBox Width="260" Text="{Binding FileName}"/>
          <Button Content="Save as PDF" Classes="accent" Command="{Binding SaveAsPdfCommand}"/>
          <Button Content="Save as images" Command="{Binding SaveAsImagesCommand}"/>
        </StackPanel>
      </StackPanel>
    </Border>

  </Grid>
</UserControl>

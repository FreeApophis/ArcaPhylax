<Project>
  <!-- The plugin build rules ship in the ArcaPhylax.Plugin.Sdk package; the in-repo plugins reference the SDK as
       a project, so import the same file directly. -->
  <Import Project="$(MSBuildThisFileDirectory)..\ArcaPhylax.Plugin.Sdk\buildTransitive\ArcaPhylax.Plugin.Sdk.targets" />

  <!-- In-repo only: make the host-provided packages compile-only at restore time too, so they do not even
       appear in the plugins' deps.json, and do not copy the SDK project's output next to the plugin. -->
  <ItemGroup Condition="'$(IsTestProject)' != 'true'">
    <PackageReference Update="Avalonia;Avalonia.Desktop;Avalonia.Themes.Fluent;Avalonia.Controls.ItemsRepeater;Avalonia.Controls.DataGrid;Autofac;CommunityToolkit.Mvvm"
                      ExcludeAssets="runtime;native" />
    <ProjectReference Update="..\..\ArcaPhylax.Plugin.Sdk\ArcaPhylax.Plugin.Sdk.csproj" Private="false" />
  </ItemGroup>
</Project>

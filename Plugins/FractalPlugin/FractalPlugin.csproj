<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<!-- ComputeSharp is DirectX 12 / Windows-only; this plugin only renders on Windows.
		     Suppress CA1416 platform-compatibility warnings for its GPU APIs. -->
		<NoWarn>$(NoWarn);CA1416</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Autofac" />
		<PackageReference Include="Funcky" />
		<PackageReference Include="ComputeSharp" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" />
		<PackageReference Include="Avalonia.Desktop" />
		<!-- Fix a vulnerable dependency -->
		<PackageReference Include="Tmds.DBus.Protocol" />
		<PackageReference Include="Avalonia.Themes.Fluent" />
		<PackageReference Include="Avalonia.Controls.ItemsRepeater" />
		<PackageReference Include="Avalonia.Controls.DataGrid" />
		<PackageReference Include="CommunityToolkit.Mvvm" />


	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\ArcaPhylax.Plugin.Sdk\ArcaPhylax.Plugin.Sdk.csproj" />
	</ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

	<!-- Plugin package metadata (plugin.json / catalog). -->
	<PropertyGroup>
		<PluginId>ArcaPhylax.Fractal</PluginId>
		<Title>Fractal</Title>
		<Description>GPU-accelerated Mandelbrot explorer with pan and zoom (DirectX 12, Windows).</Description>
		<Version>1.0.0</Version>
		<!-- ComputeSharp needs DirectX 12: only offer Windows packages. -->
		<PluginPlatforms>win-x64;win-arm64</PluginPlatforms>
	</PropertyGroup>

	<PropertyGroup>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<!-- ComputeSharp is DirectX 12 / Windows-only; this plugin only renders on Windows.
		     Suppress CA1416 platform-compatibility warnings for its GPU APIs. -->
		<NoWarn>$(NoWarn);CA1416</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Autofac" />
		<PackageReference Include="Funcky" />
		<PackageReference Include="ComputeSharp" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" />
		<PackageReference Include="Avalonia.Desktop" />
		<PackageReference Include="Avalonia.Themes.Fluent" />
		<PackageReference Include="Avalonia.Controls.ItemsRepeater" />
		<PackageReference Include="Avalonia.Controls.DataGrid" />
		<PackageReference Include="CommunityToolkit.Mvvm" />


	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\ArcaPhylax.Plugin.Sdk\ArcaPhylax.Plugin.Sdk.csproj" />
	</ItemGroup>

</Project>

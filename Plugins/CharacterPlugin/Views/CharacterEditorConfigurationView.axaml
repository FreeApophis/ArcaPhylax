<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CharacterPlugin.ViewModels"
             x:Class="CharacterPlugin.Views.CharacterEditorConfigurationView"
             x:DataType="vm:CharacterEditorConfigurationViewModel">

  <StackPanel Spacing="10">

    <StackPanel Spacing="6">
      <TextBlock Text="Cards folder" FontWeight="SemiBold"/>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox Width="360" Text="{Binding Settings.CardsDirectory}"
                 PlaceholderText="Folder containing your character card PNGs"/>
        <Button Content="Browse…" Command="{Binding BrowseCommand}"/>
      </StackPanel>
    </StackPanel>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Save" Classes="accent" Command="{Binding SaveCommand}"/>
    </StackPanel>

    <TextBlock Text="{Binding Status}" Opacity="0.7" FontSize="12"/>
  </StackPanel>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<configuration>

	<!-- Package Sources -->
	<packageSources>
		<clear />
		<!-- Offizielles NuGet -->
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
	</packageSources>

	<packageSourceMapping>
		<packageSource key="nuget.org">
			<package pattern="*" />
		</packageSource>
	</packageSourceMapping>

	<!-- Sicherheit: Nur vertrauenswürdige Signaturen -->
	<trustedSigners>
		<author name="microsoft">
			<certificate fingerprint="3F9001EA..." hashAlgorithm="SHA256" allowUntrustedRoot="false" />
		</author>
		<repository name="nuget.org" serviceIndex="https://api.nuget.org/v3/index.json">
			<certificate fingerprint="1F4B311D9ACC115C8DC8018B5A49E00FCE6DA8E2855F9F014CA6F34570BC482D" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
			<certificate fingerprint="0E5F38F57DC1BCC806D8494F4F90FBCEDD988B46760709CBEEC6F4219AA6157D" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
			<!-- nuget.org repository certificate 2021-2024: packages published then (e.g. SharpZipLib, NAPS2.Wia) carry it. -->
			<certificate fingerprint="5A2901D6ADA3D18260B9C6DFE2133C95D74B9EEF6AE0E5DC334C8454D1477DF4" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
		</repository>
	</trustedSigners>

	<config>
		<add key="globalPackagesFolder" value="%USERPROFILE%\.nuget\packages" />
		<add key="maxHttpRequestsPerSource" value="16" />
		<add key="signatureValidationMode" value="require" />
		<add key="dependencyVersion" value="HighestMinor" />
	</config>

</configuration>